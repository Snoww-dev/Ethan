# ─────────────────────────────────────────────────────────────────────────
# Ethan Ecom — cấu hình Caddy cho ethanecom.com
#
# VÌ SAO: PageSpeed báo "Use efficient cache lifetimes — 2.278 KiB" vì server
# (Caddy) hiện KHÔNG gửi header Cache-Control ⇒ trình duyệt tải lại toàn bộ
# ảnh/CSS/JS mỗi lần ghé thăm. Nén (gzip) đã bật sẵn, chỉ THIẾU cache header.
#
# CÁCH DÙNG: chép khối cấu hình dưới vào Caddyfile trên server (thường
# /etc/caddy/Caddyfile), sửa `root` cho đúng thư mục site, rồi:
#     sudo caddy validate --config /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
# ─────────────────────────────────────────────────────────────────────────

ethanecom.com, www.ethanecom.com {
    root * /var/www/ethanecom          # ← ĐỔI thành đường dẫn thật của site

    encode zstd gzip                    # nén (đang bật rồi — giữ nguyên)

    # Clean URL: /gioi-thieu → gioi-thieu.html (giống serve.py)
    try_files {path} {path}.html {path}/ =404

    # ── Ảnh · font · video · CSS · JS: cache 1 NĂM, immutable ──
    # (CSS/JS đã gắn ?v=housefXX để cache-bust khi đổi nội dung nên cache dài an toàn)
    @assets path *.webp *.avif *.jpg *.jpeg *.png *.gif *.svg *.ico \
                 *.woff *.woff2 *.ttf *.otf *.eot *.mp4 *.webm *.css *.js
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # ── Trang HTML (kể cả clean URL không đuôi): luôn revalidate ──
    # để nội dung cập nhật hiện ra ngay, không bị kẹt bản cũ.
    @pages not path *.webp *.avif *.jpg *.jpeg *.png *.gif *.svg *.ico \
                    *.woff *.woff2 *.ttf *.otf *.eot *.mp4 *.webm *.css *.js
    header @pages Cache-Control "public, max-age=0, must-revalidate"

    file_server
}

# ─────────────────────────────────────────────────────────────────────────
# Nếu chỉ muốn THÊM header vào cấu hình sẵn có (không thay cả block),
# chỉ cần chèn 4 dòng @assets/@pages ở trên vào trong block site hiện tại.
# ─────────────────────────────────────────────────────────────────────────
